bin/
lib64/
lib/
pyvenv.cfg
venv/
.env
# The dev machine's own local config, gitignored for the same reason - never
# bake a builder's personal settings (debug=True, a hardcoded local path,
# ...) into a public image. Dockerfile falls back to config_example.ini's
# defaults when this is absent, which is the only reproducible behavior.
config.ini
.git
__pycache__
*.pyc
.gitignore

# Sqlite database files
*.db
*.db
*.db-wal
*.db-shm
*.log
*.sqlite3

#IDE stuff
.vscode/
.idea/

# Nginx

# Ignore any active overrides generated locally
nginx/config_overrides/*.conf

# Explicitly allow the inactive templates
!nginx/config_overrides/*.inactive