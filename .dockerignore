bin/
lib64/
lib/
pyvenv.cfg
venv/
.env
# .env's own local-secrets sibling (see CLAUDE.md); exact-name .env above
# doesn't catch it.
.claude.env
# Each machine's own local config - gitignored for the same reason. Absent
# here, the Dockerfile falls back to config_example.ini's defaults.
config.ini
.git
__pycache__
*.pyc
.gitignore
.pytest_cache/

# Claude Code's own local project files - never meant to ship.
CLAUDE.md
.claude/

# Self-signed cert/key generated by tests/containertests/run_tests.py's
# https_enabled fixture, and the HOST_CACHE_PATH override it and the
# casterpak_stack fixture point at - both local-only, cleaned up after each
# run, but must never end up baked into a pushed image if a build happens to
# run while either exists on disk.
nginx/ssl/*.crt
nginx/ssl/*.key
containertests_cache/

# Sqlite database files
*.db
*.db
*.db-wal
*.db-shm
*.log
*.sqlite3

#IDE stuff
.vscode/
.idea/

# Nginx

# Ignore any active overrides generated locally
nginx/config_overrides/*.conf

# Explicitly allow the inactive templates
!nginx/config_overrides/*.inactive