bin/
lib64/
lib/
pyvenv.cfg
venv/
.env
# Each machine's own local config - gitignored for the same reason. Absent
# here, the Dockerfile falls back to config_example.ini's defaults.
config.ini
.git
__pycache__
*.pyc
.gitignore

# Sqlite database files
*.db
*.db
*.db-wal
*.db-shm
*.log
*.sqlite3

#IDE stuff
.vscode/
.idea/

# Nginx

# Ignore any active overrides generated locally
nginx/config_overrides/*.conf

# Explicitly allow the inactive templates
!nginx/config_overrides/*.inactive