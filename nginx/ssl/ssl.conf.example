server {
    listen 443 ssl;
    server_name video.casterpak.com;

    ssl_certificate     /etc/letsencrypt/live/video.casterpak.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/video.casterpak.com/privkey.pem;

    location / {
        proxy_pass http://casterpak:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        include /etc/nginx/config_overrides/*.conf;
    }

    location /protected_media/ {
        internal;
        alias /var/cache/casterpak/segments/;
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        default_type video/MP2T;
        add_header Access-Control-Allow-Origin *;
    }

    location /testing/ {
        alias /etc/nginx/html/testing/;
        index test_player.html;
    }

    proxy_buffering off;
    proxy_request_buffering off;
}