# .env.example
# The path to your local MP4 video library
HOST_VIDEO_PATH=/home/user/Videos

# The Cache Volume from docs/Hosting-instructions - CasterPak's own
# transcodes/input-copies/HLS-segment cache lives here, as sub-directories
# it manages itself. Mount a dedicated drive here in production.
HOST_CACHE_PATH=/var/cache/casterpak

# Optional: The port you want to run CasterPak on
APP_PORT=5000

# Image/build version tag - keep in sync with the VERSION file at repo root.
# TEMPORARY: this manual sync goes away once a real CI/CD release pipeline
# sets it from the git tag (see Dockerfile and docker-compose.yml).
CASTERPAK_VERSION=0.9.1-alpha

# --- Optional: the library service (user accounts + upload). Start it with
#     docker compose --profile library up -d --build
# REQUIRED for the library, 32+ chars:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CASTERPAK_LIBRARY_JWT_SECRET=
# closed (admin creates users), invite, or open. See config_example.ini [library].
CASTERPAK_LIBRARY_REGISTRATION=closed
# The public address of CasterPak, used to build the URLs users embed.
CASTERPAK_LIBRARY_CASTERPAK_URL=http://localhost

# --- Optional: S3 as the library instead of a directory (see docs/s3-input.md)
# CASTERPAK_INPUT_INPUT_TYPE=s3
# CASTERPAK_S3_BUCKET=my-video-library
# CASTERPAK_S3_PREFIX=videos/
# CASTERPAK_S3_REGION=us-east-1
# Credentials: prefer an instance/task IAM role. Otherwise CASTERPAK_S3_ACCESS_KEY_ID / _SECRET_ACCESS_KEY.
